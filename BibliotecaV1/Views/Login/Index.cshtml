@model BibliotecaV1.Models.LoginViewModel

@{
Layout = null;
ViewData["Title"] = "Login";
}

<!DOCTYPE html> <html lang="pt-br"> <head> <meta charset="utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Biblioteca - Login</title>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<style>

    body {
        margin: 0;
        height: 100vh;
        background: #0d1117;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', sans-serif;
    }

    .login-card {
        width: 430px;
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 18px;
        padding: 40px;
    }

    .logo {
        text-align: center;
        font-size: 50px;
        color: #f0f6fc;
        margin-bottom: 15px;
    }

    .title {
        text-align: center;
        color: #f0f6fc;
        font-weight: 600;
        font-size: 28px;
        margin-bottom: 5px;
    }

    .subtitle {
        text-align: center;
        color: #8b949e;
        margin-bottom: 30px;
        font-size: 14px;
    }

    .form-label {
        color: #c9d1d9;
        margin-bottom: 8px;
    }

    .form-control {
        background: #0d1117;
        border: 1px solid #30363d;
        color: #f0f6fc;
        border-radius: 10px;
        padding: 12px;
    }

    .form-control:focus {
        background: #0d1117;
        color: #fff;
        border-color: #484f58;
        box-shadow: none;
    }

    .btn-login {
        background: #21262d;
        border: 1px solid #30363d;
        color: #f0f6fc;
        border-radius: 10px;
        padding: 12px;
        font-weight: 500;
    }

    .btn-login:hover {
        background: #30363d;
        color: #fff;
    }

    .text-danger {
        font-size: 14px;
    }

</style>
</head> <body>
<div class="login-card">

    <div class="logo">
        <i class="bi bi-book-half"></i>
    </div>

    <div class="title">
        Biblioteca
    </div>

    <div class="subtitle">
        Sistema de Gerenciamento de Biblioteca
    </div>

    <form asp-action="Index" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label asp-for="Email"
                   class="form-label">
                E-mail
            </label>

            <input asp-for="Email"
                   class="form-control" />

            <span asp-validation-for="Email"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-4">

            <label asp-for="Senha"
                   class="form-label">
                Senha
            </label>

            <input asp-for="Senha"
                   type="password"
                   class="form-control" />

            <span asp-validation-for="Senha"
                  class="text-danger">
            </span>

        </div>

        <button type="submit"
                class="btn btn-login w-100">
            Entrar
        </button>

    </form>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body> </html>