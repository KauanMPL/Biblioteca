@using Microsoft.AspNetCore.Http

@{
var title = ViewData["Title"] ?? "Biblioteca";

var usuarioId = Context.Session.GetInt32("UsuarioId");
var usuarioNome = Context.Session.GetString("UsuarioNome");


}

<!DOCTYPE html>

<html lang="pt-br">

<head>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>@title - Biblioteca</title>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<style>

    body {
        background: #0d1117;
        color: #e6edf3;
        min-height: 100vh;
    }

    .navbar-custom {
        background: #111827;
        border-bottom: 1px solid #1f2937;
        padding: 14px 24px;
    }

    .navbar-brand {
        color: #ffffff !important;
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: .5px;
    }

    .navbar-brand:hover {
        color: #ffffff !important;
    }

    .nav-link {
        color: #9ca3af !important;
        font-weight: 500;
        transition: .2s;
        padding: 8px 14px !important;
        border-radius: 10px;
    }

    .nav-link:hover {
        background: #1f2937;
        color: #ffffff !important;
    }

    .user-area {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .user-name {
        color: #d1d5db;
        font-weight: 500;
    }

    .btn-logout {
        text-decoration: none;
        color: #e5e7eb;
        border: 1px solid #374151;
        padding: 8px 16px;
        border-radius: 10px;
        transition: .2s;
        font-weight: 500;
    }

    .btn-logout:hover {
        background: #1f2937;
        color: white;
    }

    .main-container {
        max-width: 1400px;
        margin: auto;
        padding: 30px 20px;
    }

    .navbar-toggler {
        border-color: #374151;
    }

    .navbar-toggler:focus {
        box-shadow: none;
    }

</style>


</head>

<body>


@if (usuarioId != null)
{
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">

        <div class="container-fluid">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">
                Biblioteca
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Usuarios"
                           asp-action="Index">

                            <i class="bi bi-people-fill me-1"></i>
                            Usuários

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Livros"
                           asp-action="Index">

                            <i class="bi bi-book-fill me-1"></i>
                            Livros

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Emprestimoes"
                           asp-action="Index">

                            <i class="bi bi-journal-text me-1"></i>
                            Empréstimos

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Relatorios"
                           asp-action="Historico">

                            <i class="bi bi-bar-chart-fill me-1"></i>
                            Relatórios

                        </a>

                    </li>

                </ul>

                <div class="user-area">

                    <span class="user-name">

                        <i class="bi bi-person-circle me-1"></i>
                        @usuarioNome

                    </span>

                    <a asp-controller="Login"
                       asp-action="Logout"
                       class="btn-logout">

                        Sair

                    </a>

                </div>

            </div>

        </div>

    </nav>
}

<main class="main-container">

    @RenderBody()

</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)


</body>

</html>
