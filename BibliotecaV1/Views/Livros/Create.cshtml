@model BibliotecaV1.Models.Livro

@{
ViewData["Title"] = "Novo Livro";
}

<style> .form-container { background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 32px; max-width: 700px; } .btn-save { background: #21262d; color: #f0f6fc; border: 1px solid #30363d; padding: 12px 18px; border-radius: 10px; font-weight: 500; } .btn-save:hover { background: #30363d; color: #fff; } .btn-back { background: transparent; color: #9ca3af; border: 1px solid #30363d; padding: 12px 18px; border-radius: 10px; text-decoration: none; } .btn-back:hover { background: #21262d; color: #fff; } .form-control { background: #0d1117; border: 1px solid #30363d; color: #e6edf3; border-radius: 10px; } .form-control:focus { background: #0d1117; color: #fff; border-color: #484f58; box-shadow: none; } </style> <div class="form-container">
<h2 class="mb-4 text-light">
    Novo Livro
</h2>

<form asp-action="Create">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">

        <label asp-for="NomeLivro"
               class="form-label text-light">
        </label>

        <input asp-for="NomeLivro"
               class="form-control" />

        <span asp-validation-for="NomeLivro"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Autor"
               class="form-label text-light">
        </label>

        <input asp-for="Autor"
               class="form-control" />

        <span asp-validation-for="Autor"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="QuantidadeEstoque"
               class="form-label text-light">
        </label>

        <input asp-for="QuantidadeEstoque"
               class="form-control" />

        <span asp-validation-for="QuantidadeEstoque"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="FaixaEtariaPermitida"
               class="form-label text-light">
        </label>

        <input asp-for="FaixaEtariaPermitida"
               class="form-control" />

        <span asp-validation-for="FaixaEtariaPermitida"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Categoria"
               class="form-label text-light">
        </label>

        <input asp-for="Categoria"
               class="form-control" />

        <span asp-validation-for="Categoria"
              class="text-danger">
        </span>

    </div>

    <div class="mb-4">

        <label asp-for="AnoPublicacao"
               class="form-label text-light">
        </label>

        <input asp-for="AnoPublicacao"
               class="form-control" />

        <span asp-validation-for="AnoPublicacao"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn-save">
        Salvar Livro
    </button>

    <a asp-action="Index"
       class="btn-back">
        Voltar
    </a>

</form>
</div>

@section Scripts {
@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}