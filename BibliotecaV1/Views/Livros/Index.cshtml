@model IEnumerable<BibliotecaV1.Models.Livro>

@{
    ViewData["Title"] = "Livros";
}

<h2>📚 Livros</h2>

<form method="get" asp-action="Index" class="mb-3">
    <div class="input-group">

        <input type="text"
               name="busca"
               value="@ViewBag.Busca"
               class="form-control"
               placeholder="Buscar por título, autor ou categoria..." />

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>

        <a asp-action="Disponiveis"
               class="btn btn-success">
            <i class="bi bi-book"></i> Disponíveis
        </a>

        <a asp-action="Create"
               class="btn btn-dark">
            <i class="bi bi-plus-circle"></i> Novo Livro
        </a>

    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Livro</th>
            <th>Autor</th>
            <th>Categoria</th>
            <th>Ano</th>
            <th>Estoque</th>
            <th>Faixa Etária</th>
            <th width="250">Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>@item.NomeLivro</td>

                <td>@item.Autor</td>

                <td>@item.Categoria</td>

                <td>@item.AnoPublicacao</td>

                <td>
                    @if (item.QuantidadeEstoque > 0)
                    {
                        <span class="badge bg-success">
                            @item.QuantidadeEstoque disponível(is)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Indisponível
                        </span>
                    }
                </td>

                <td>
                    <span class="badge bg-secondary">
                        @item.FaixaEtariaPermitida+
                    </span>
                </td>

                <td>

                    <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i> Editar
                    </a>

                    <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                        <i class="bi bi-eye"></i> Detalhes
                    </a>

                    <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i> Excluir
                    </a>

                </td>

            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        Nenhum livro encontrado.
    </div>
}