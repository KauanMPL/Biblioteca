@{
ViewData["Title"] = "Dashboard";
}

<style> .page-title { color: #f0f6fc; font-weight: 700; margin-bottom: 30px; } .stat-card { background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 25px; text-align: center; height: 100%; } .stat-number { color: #f0f6fc; font-size: 2rem; font-weight: 700; margin-bottom: 8px; } .stat-label { color: #8b949e; font-size: .95rem; margin: 0; } .summary-card { background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 25px; margin-top: 20px; } .summary-title { color: #8b949e; font-size: 1rem; margin-bottom: 10px; } .summary-value { color: #f0f6fc; font-size: 2rem; font-weight: 700; margin: 0; } </style> <h2 class="page-title"> Dashboard </h2> <div class="row g-4">
<div class="col-md-3">

    <div class="stat-card">

        <div class="stat-number">
            @ViewBag.TotalUsuarios
        </div>

        <p class="stat-label">
            Usuários
        </p>

    </div>

</div>

<div class="col-md-3">

    <div class="stat-card">

        <div class="stat-number">
            @ViewBag.TotalLivros
        </div>

        <p class="stat-label">
            Livros
        </p>

    </div>

</div>

<div class="col-md-3">

    <div class="stat-card">

        <div class="stat-number">
            @ViewBag.EmprestimosAtivos
        </div>

        <p class="stat-label">
            Empréstimos Ativos
        </p>

    </div>

</div>

<div class="col-md-3">

    <div class="stat-card">

        <div class="stat-number">
            @ViewBag.Atrasados
        </div>

        <p class="stat-label">
            Empréstimos Atrasados
        </p>

    </div>

</div>
</div> <div class="summary-card">
<div class="summary-title">
    Total em Multas
</div>

<h3 class="summary-value">
    @ViewBag.TotalMultas.ToString("C")
</h3>
</div>