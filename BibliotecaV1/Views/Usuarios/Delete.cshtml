@model BibliotecaV1.Models.Usuario

@{
ViewData["Title"] = "Excluir Usuário";
}

<style> .content-card { background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 32px; max-width: 800px; margin: 0 auto; } .page-title { color: #f0f6fc; font-size: 28px; font-weight: 600; margin-bottom: 10px; } .alert-custom { background: rgba(248, 81, 73, 0.1); border: 1px solid rgba(248, 81, 73, 0.3); color: #f85149; border-radius: 10px; padding: 15px; margin-bottom: 25px; } .info-box { background: #0d1117; border: 1px solid #30363d; border-radius: 12px; overflow: hidden; } .info-item { display: flex; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid #30363d; } .info-item:last-child { border-bottom: none; } .label { color: #8b949e; font-weight: 500; } .value { color: #f0f6fc; font-weight: 500; } .status-active { background: rgba(35,134,54,.2); color: #3fb950; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; } .status-inactive { background: rgba(248,81,73,.2); color: #f85149; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; } .btn-delete { background: #da3633; border: none; color: white; padding: 12px 18px; border-radius: 10px; font-weight: 500; } .btn-delete:hover { background: #f85149; color: white; } .btn-back { background: transparent; color: #9ca3af; border: 1px solid #30363d; padding: 12px 18px; border-radius: 10px; text-decoration: none; margin-left: 10px; } .btn-back:hover { background: #21262d; color: white; } </style> <div class="content-card">
<h2 class="page-title">
    Excluir Usuário
</h2>

<div class="alert-custom">
    Tem certeza que deseja excluir este usuário? Esta ação não poderá ser desfeita.
</div>

<div class="info-box">

    <div class="info-item">
        <span class="label">Nome Completo</span>
        <span class="value">@Model.NomeCompleto</span>
    </div>

    <div class="info-item">
        <span class="label">Data de Nascimento</span>
        <span class="value">@Model.DataNascimento.ToString("dd/MM/yyyy")</span>
    </div>

    <div class="info-item">
        <span class="label">Email</span>
        <span class="value">@Model.Email</span>
    </div>

    <div class="info-item">
        <span class="label">Senha</span>
        <span class="value">••••••••</span>
    </div>

    <div class="info-item">
        <span class="label">Status</span>

        @if (Model.Ativo)
        {
            <span class="status-active">
                Ativo
            </span>
        }
        else
        {
            <span class="status-inactive">
                Inativo
            </span>
        }
    </div>

</div>

<form asp-action="Delete" class="mt-4">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn-delete">
        Excluir Usuário
    </button>

    <a asp-action="Index" class="btn-back">
        Voltar
    </a>

</form>
</div>