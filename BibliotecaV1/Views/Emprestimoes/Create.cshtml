@model BibliotecaV1.Models.Emprestimo

@{
ViewData["Title"] = "Novo Empréstimo";
}

<style>
    .form-container {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 16px;
    padding: 32px;
    max-width: 700px;
}

.btn-save {
    background: #21262d;
    color: #f0f6fc;
    border: 1px solid #30363d;
    padding: 12px 18px;
    border-radius: 10px;
    font-weight: 500;
}

.btn-save:hover {
    background: #30363d;
    color: #fff;
}

.btn-back {
    background: transparent;
    color: #9ca3af;
    border: 1px solid #30363d;
    padding: 12px 18px;
    border-radius: 10px;
    text-decoration: none;
}

.btn-back:hover {
    background: #21262d;
    color: #fff;
}

.form-control,
.form-select {
    background: #0d1117;
    border: 1px solid #30363d;
    color: #e6edf3;
    border-radius: 10px;
}

.form-control:focus,
.form-select:focus {
    background: #0d1117;
    color: #fff;
    border-color: #484f58;
    box-shadow: none;
}
</style>
<form asp-action="Create">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">

        <label asp-for="UsuarioId"
               class="form-label">
            Usuário
        </label>

        <select asp-for="UsuarioId"
                class="form-select"
                asp-items="ViewBag.UsuarioId">

            <option value="">
                Selecione um usuário
            </option>

        </select>

        <span asp-validation-for="UsuarioId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="LivroId"
               class="form-label">
            Livro
        </label>

        <select asp-for="LivroId"
                class="form-select"
                asp-items="ViewBag.LivroId">

            <option value="">
                Selecione um livro
            </option>

        </select>

        <span asp-validation-for="LivroId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-4">

        <label asp-for="DataPrevistaDevolucao"
               class="form-label">
            Data Prevista de Devolução
        </label>

        <input asp-for="DataPrevistaDevolucao"
               type="date"
               class="form-control" />

        <span asp-validation-for="DataPrevistaDevolucao"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn-save">
        Registrar Empréstimo
    </button>

    <a asp-action="Index"
       class="btn-back">
        Voltar
    </a>

</form>
</div>

@section Scripts {
@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}