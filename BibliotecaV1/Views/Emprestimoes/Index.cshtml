@model IEnumerable<BibliotecaV1.Models.Emprestimo>

@{
    ViewData["Title"] = "Empréstimos";
}

<h2>📚 Controle de Empréstimos</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Novo Empréstimo
    </a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Usuário</th>
            <th>Livro</th>
            <th>Data Empréstimo</th>
            <th>Devolução Prevista</th>
            <th>Status</th>
            <th>Multa</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>
                    @item.Usuario?.NomeCompleto
                </td>

                <td>
                    @item.Livro?.NomeLivro
                </td>

                <td>
                    @item.DataEmprestimo.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @item.DataPrevistaDevolucao.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @if (item.Status == "Emprestado")
                    {
                        <span class="badge bg-primary">
                            Emprestado
                        </span>
                    }
                    else if (item.Status == "Devolvido")
                    {
                        <span class="badge bg-success">
                            Devolvido
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Atrasado
                        </span>
                    }
                </td>

                <td>
                    @if (item.Multa > 0)
                    {
                        <span class="text-danger fw-bold">
                            @item.Multa.ToString("C")
                        </span>
                    }
                    else
                    {
                        <span class="text-success">
                            R$ 0,00
                        </span>
                    }
                </td>

                <td class="text-end">

                    <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                        <i class="bi bi-eye"></i>
                        Detalhes
                    </a>

                    @if (item.Status == "Emprestado")
                    {
                        <a asp-action="Devolver"
                               asp-route-id="@item.Id"
                               class="btn btn-success btn-sm"
                               onclick="return confirm('Confirmar devolução deste livro?')">
                            <i class="bi bi-check-circle"></i>
                            Devolver
                        </a>
                    }

                    <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i>
                        Editar
                    </a>

                    <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i>
                        Excluir
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>