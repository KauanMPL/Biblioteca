@model IEnumerable<BibliotecaV1.Models.Emprestimo>

@{
ViewData["Title"] = "Empréstimos";
}

<style>
    body {
        background: #0d1117;
    }

    .page-title {
        color: #fff;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .table-container {
        background: #161b22;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #30363d;
        box-shadow: 0 10px 35px rgba(0,0,0,.35);
        margin-top: 20px;
    }

    .custom-table {
        margin: 0;
        color: #e6edf3;
    }

    .custom-table thead {
        background: linear-gradient(135deg,#1f2937,#111827);
    }

    .custom-table thead th {
        color: #60a5fa;
        border: none;
        padding: 18px;
        font-weight: 600;
    }

    .custom-table tbody tr {
        background: #0d1117;
        transition: .25s;
    }

    .custom-table tbody tr:hover {
        background: #1c2128;
        transform: scale(1.01);
    }

    .custom-table td {
        border-color: #30363d;
        padding: 16px;
        vertical-align: middle;
    }

    .badge {
        border-radius: 12px;
        padding: 8px 12px;
    }

    .btn-new {
        background: linear-gradient(135deg,#3b82f6,#2563eb);
        color: white;
        border: none;
        border-radius: 14px;
        padding: 10px 18px;
        text-decoration: none;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(59,130,246,.35);
        transition: .25s;
    }

    .btn-new:hover {
        color: white;
        transform: translateY(-3px);
    }

    .action-buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: end;
    }

    .btn-details,
    .btn-return,
    .btn-edit,
    .btn-delete {
        border: none;
        border-radius: 14px;
        padding: 8px 14px;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: .25s;
    }

    .btn-details {
        background: linear-gradient(135deg,#3b82f6,#2563eb);
        color: white;
        box-shadow: 0 4px 15px rgba(59,130,246,.35);
    }

    .btn-return {
        background: linear-gradient(135deg,#22c55e,#16a34a);
        color: white;
        box-shadow: 0 4px 15px rgba(34,197,94,.35);
    }

    .btn-edit {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: white;
        box-shadow: 0 4px 15px rgba(245,158,11,.35);
    }

    .btn-delete {
        background: linear-gradient(135deg,#ef4444,#dc2626);
        color: white;
        box-shadow: 0 4px 15px rgba(239,68,68,.35);
    }

    .btn-details:hover,
    .btn-return:hover,
    .btn-edit:hover,
    .btn-delete:hover {
        color: white;
        transform: translateY(-3px);
    }

    .btn-details:active,
    .btn-return:active,
    .btn-edit:active,
    .btn-delete:active {
        transform: scale(.96);
    }
</style>

<h2 class="page-title">📚 Controle de Empréstimos</h2>

<p>
    <a asp-action="Create" class="btn-new">
        <i class="bi bi-plus-circle"></i>
        Novo Empréstimo
    </a>
</p>

<div class="table-container">

<table class="table custom-table align-middle mb-0">

    <thead>
        <tr>
            <th>ID</th>
            <th>Usuário</th>
            <th>Livro</th>
            <th>Data Empréstimo</th>
            <th>Devolução Prevista</th>
            <th>Status</th>
            <th>Multa</th>
            <th width="420" class="text-end">Ações</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.Usuario?.NomeCompleto</td>

                <td>@item.Livro?.NomeLivro</td>

                <td>@item.DataEmprestimo.ToString("dd/MM/yyyy")</td>

                <td>@item.DataPrevistaDevolucao.ToString("dd/MM/yyyy")</td>

                <td>
                    @if (item.Status == "Emprestado")
                    {
                        <span class="badge bg-primary">
                            Emprestado
                        </span>
                    }
                    else if (item.Status == "Devolvido")
                    {
                        <span class="badge bg-success">
                            Devolvido
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Atrasado
                        </span>
                    }
                </td>

                <td>
                    @if (item.Multa > 0)
                    {
                        <span class="text-danger fw-bold">
                            @item.Multa.ToString("C")
                        </span>
                    }
                    else
                    {
                        <span class="text-success">
                            R$ 0,00
                        </span>
                    }
                </td>

                <td>
                    <div class="action-buttons">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn-details">
                            <i class="bi bi-eye-fill"></i>
                            Detalhes
                        </a>

                        @if (item.Status == "Emprestado")
                        {
                            <a asp-action="Devolver"
                               asp-route-id="@item.Id"
                               class="btn-return"
                               onclick="return confirm('Confirmar devolução deste livro?')">
                                <i class="bi bi-check-circle-fill"></i>
                                Devolver
                            </a>
                        }

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn-edit">
                            <i class="bi bi-pencil-square"></i>
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn-delete">
                            <i class="bi bi-trash-fill"></i>
                            Excluir
                        </a>

                    </div>
                </td>

            </tr>
        }

    </tbody>

</table>


</div>
