@model BibliotecaV1.Models.Emprestimo

@{
ViewData["Title"] = "Detalhes do Empréstimo";
}

<style> .page-title { color: #f0f6fc; font-weight: 700; margin-bottom: 25px; } .page-card { background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 30px; } .info-box { background: #0d1117; border: 1px solid #30363d; border-radius: 12px; overflow: hidden; } .info-item { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #30363d; } .info-item:last-child { border-bottom: none; } .label { color: #8b949e; font-weight: 500; } .value { color: #f0f6fc; font-weight: 500; } .btn-edit { background: #21262d; color: #f0f6fc; border: 1px solid #30363d; padding: 10px 18px; border-radius: 10px; text-decoration: none; margin-right: 10px; font-weight: 500; } .btn-edit:hover { background: #30363d; color: white; } .btn-back { background: transparent; color: #8b949e; border: 1px solid #30363d; padding: 10px 18px; border-radius: 10px; text-decoration: none; font-weight: 500; } .btn-back:hover { background: #21262d; color: white; } .badge { padding: 7px 12px; border-radius: 10px; font-weight: 500; } </style> <div class="page-card">
<h2 class="page-title">
    Detalhes do Empréstimo
</h2>

<div class="info-box">

    <div class="info-item">
        <span class="label">Usuário</span>
        <span class="value">
            @Model.Usuario?.NomeCompleto
        </span>
    </div>

    <div class="info-item">
        <span class="label">Livro</span>
        <span class="value">
            @Model.Livro?.NomeLivro
        </span>
    </div>

    <div class="info-item">
        <span class="label">Autor</span>
        <span class="value">
            @Model.Livro?.Autor
        </span>
    </div>

    <div class="info-item">
        <span class="label">Data Empréstimo</span>
        <span class="value">
            @Model.DataEmprestimo.ToString("dd/MM/yyyy")
        </span>
    </div>

    <div class="info-item">
        <span class="label">Devolução Prevista</span>
        <span class="value">
            @Model.DataPrevistaDevolucao.ToString("dd/MM/yyyy")
        </span>
    </div>

    <div class="info-item">
        <span class="label">Data Devolução</span>
        <span class="value">
            @(Model.DataRealDevolucao?.ToString("dd/MM/yyyy") ?? "Não devolvido")
        </span>
    </div>

    <div class="info-item">
        <span class="label">Multa</span>
        <span class="value">
            @Model.Multa.ToString("C")
        </span>
    </div>

    <div class="info-item">

        <span class="label">Status</span>

        @if (Model.Status == "Emprestado")
        {
            <span class="badge bg-primary">
                Emprestado
            </span>
        }
        else if (Model.Status == "Devolvido")
        {
            <span class="badge bg-success">
                Devolvido
            </span>
        }
        else
        {
            <span class="badge bg-danger">
                Atrasado
            </span>
        }

    </div>

</div>

<div class="mt-4">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn-edit">
        Editar
    </a>

    <a asp-action="Index"
       class="btn-back">
        Voltar
    </a>

</div>
</div>